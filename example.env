# Required ---------------------------------------------------------------
MONGODB_URL=
SESSION_SECRET=

# AWS S3 (for the media proxy + uploads)
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=

# Pusher (real-time updates: watchword/cover/profile/email channels)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Optional ---------------------------------------------------------------
# Postmark email integration (the in-app email client is currently disabled;
# these only need to be set if you re-enable it).
POSTMARK_TOKEN=
POSTMARK_INBOUND_ADDRESS=
# Set to "1" to enable the per-pageload "opened" backfill that the admin
# h.tsx loader runs against the Postmark API. Off by default to avoid
# slowing down admin pageloads when the email feature isn't in use.
ENABLE_POSTMARK_BACKFILL=

# IPStack — used by the (currently commented-out) Analytics component to
# geolocate visitors.
IPSTACK_APIKEY=

# Geocoding API key (used by older OG/scraper code paths).
GEOCODE_APIKEY=
